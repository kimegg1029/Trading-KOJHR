NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/ozu_trading
# Generate with: node server/generate-secrets.js
SESSION_SECRET=replace_with_a_long_random_secret
# Base64-encoded 32-byte key. Never commit the real value.
ENCRYPTION_KEY=replace_with_base64_32_byte_key
# Store bcrypt hashes only, not plain passwords. Generate with server/hash-password.js.
OZU_PASSWORD_HASH=
HYERYEONG_PASSWORD_HASH=
# Live order routes remain blocked unless explicitly enabled after testing.
LIVE_TRADING_ENABLED=false
# Required production deployment uses HTTPS.
TRUST_PROXY=0
